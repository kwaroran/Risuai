exports[`Imagen > sends the provider request 1`] = `
{
  "fetch": [],
  "fetchNative": [],
  "globalFetch": [
    [
      "https://generativelanguage.googleapis.com/v1beta/models/imagen-4.0-generate-001:predict?key=google-key",
      {
        "body": {
          "instances": [
            {
              "prompt": "a cat",
            },
          ],
          "parameters": {
            "aspectRatio": "16:9",
            "personGeneration": "allow_adult",
            "sampleCount": 1,
            "sampleImageSize": "2K",
          },
        },
        "headers": {
          "Content-Type": "application/json",
        },
        "method": "POST",
      },
    ],
  ],
}
`;

